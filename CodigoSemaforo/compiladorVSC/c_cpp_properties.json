{
    "configurations": [
        {
            "name": "Win32",
            "includePath": [
                "${workspaceFolder}/**"
            ],
            "defines": [
                "_DEBUG",
                "UNICODE",
                "_UNICODE"
            ],
            "compilerPath": "C:/Tools/AVR/avr8-gnu-toolchain/bin/avr-gcc.exe",
            "cStandard": "c11",
            "cppStandard": "gnu++14",
            "intelliSenseMode": "windows-gcc-x64",
            "compilerArgs": [
                "-mmcu=atmega128",//Garantizará que las definiciones de MCU estén configuradas correctamente.
                "-DF_CPU=16000000UL",//Asegurará que F_CPU esté configurado correctamente.
                "-Os"//Se evitarán las advertencias de optimización relacionadas con _delay
            ]
        }
    ],
    "version": 4
}